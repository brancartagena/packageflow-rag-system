# Copy to .env and edit. Every line is optional; defaults are shown.

# Ollama server
OLLAMA_HOST=http://localhost:11434

# Chat model: run `ollama list` and put your model name here
OLLAMA_CHAT_MODEL=llama3.1:8b
# Context window sent to Ollama. Ollama's default is small, keep this explicit.
OLLAMA_NUM_CTX=8192
LLM_TEMPERATURE=0.1
# Seconds to wait for Ollama (the first call loads the model and can be slow on CPU)
OLLAMA_TIMEOUT=300
# How long Ollama keeps the chat model loaded after an answer (Ollama's own default is 5m, so the first
# question after a break is slow on CPU)
OLLAMA_KEEP_ALIVE=30m

# Embedding model (must match what the index was built with)
EMBED_MODEL=qwen3-embedding:0.6b
# EMBED_MODEL=nomic-embed-text
EMBED_BATCH_SIZE=16

# Vision model, only used by scripts/describe_image.py
VISION_MODEL=qwen2.5vl:7b

# Paths
SOURCE_DIR=data/source
DERIVED_DIR=data/derived
PROCESSED_DIR=data/processed
# Keep the vector index and logs OUTSIDE OneDrive so sync doesn't lock/corrupt them
INDEX_DIR=~/.packageflow-rag/index
LOG_DIR=~/.packageflow-rag/logs
COLLECTION_NAME=packageflow_docs

# Chunking
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=50

# Retrieval
TOP_K=8
CANDIDATE_K=25
RRF_K=60
# 0 = off. If the best match scores below this, answer "not covered" without asking the LLM.
# scripts/evaluate.py suggests a value.
MIN_DENSE_SCORE=0
